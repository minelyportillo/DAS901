@model ClinicaApp.Services.PatientChartData

@{
    ViewData["Title"] = "Expediente del paciente";
}

<div class="page-heading">
    <div>
        <p class="page-kicker">EXPEDIENTE CLÍNICO</p>
        <h1>Expediente del paciente</h1>
        <p class="page-subtitle">Datos personales, alergias, enfermedades, estudios y consultas asociadas.</p>
    </div>
    <a class="btn btn-light-blue" asp-action="Buscar">&larr; Volver a pacientes</a>
</div>

<section class="patient-summary-card">
    <span class="patient-large-avatar" aria-hidden="true">@Model.Patient.Nombre[..1].ToUpperInvariant()</span>
    <div class="patient-summary-name">
        <h2>@Model.Patient.Nombre</h2>
        <p>Expediente #@Model.Patient.Id</p>
        <span class="role-pill">@Model.Patient.Age años</span>
    </div>
    <dl class="patient-facts">
        <div><dt>DUI</dt><dd>@(string.IsNullOrWhiteSpace(Model.Patient.Dui) ? "No registrado" : Model.Patient.Dui)</dd></div>
        <div><dt>Fecha de nacimiento</dt><dd>@Model.Patient.FechaNacimiento.ToString("dd/MM/yyyy")</dd></div>
    </dl>
</section>

<div class="row g-3 my-1">
    <div class="col-md-6">
        <section class="info-card h-100">
            <p class="card-eyebrow">ALERGIAS DEL PACIENTE (alergias_paciente)</p>
            @if (Model.Alergias.Count == 0)
            {
                <p class="info-card-value">Sin alergias registradas</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @foreach (var alergia in Model.Alergias)
                    {
                        <span class="history-tag">
                            <strong>@alergia.TipoAlergia:</strong> @alergia.SustanciaElemento
                            <small class="text-muted">(@alergia.Severidad)</small>
                        </span>
                    }
                </div>
            }
            @if (User.IsInRole("Doctora"))
            {
                <form asp-action="AgregarAlergia" method="post" class="mt-3 pt-2 border-top">
                    <input type="hidden" name="PatientId" value="@Model.Patient.Id" />
                    <div class="row g-2">
                        <div class="col-sm-4">
                            <label class="visually-hidden" for="tipoAlergia">Tipo de alergia</label>
                            <select id="tipoAlergia" name="TipoAlergia" class="form-select form-select-sm" required>
                                <option value="">Tipo de alergia...</option>
                                <option value="Medicamento">Medicamento</option>
                                <option value="Alimento">Alimento</option>
                                <option value="Ambiental">Ambiental</option>
                                <option value="Contacto">Contacto</option>
                                <option value="Otra">Otra</option>
                            </select>
                        </div>
                        <div class="col-sm-5">
                            <label class="visually-hidden" for="sustanciaElemento">Sustancia o elemento</label>
                            <input id="sustanciaElemento" name="SustanciaElemento" class="form-control form-control-sm" maxlength="150" placeholder="Sustancia (ej. Penicilina)" required />
                        </div>
                        <div class="col-sm-3">
                            <label class="visually-hidden" for="severidadAlergia">Severidad</label>
                            <select id="severidadAlergia" name="Severidad" class="form-select form-select-sm" required>
                                <option value="Leve">Leve</option>
                                <option value="Moderada" selected>Moderada</option>
                                <option value="Severa">Severa</option>
                            </select>
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                            <button class="btn btn-light-blue btn-sm" type="submit">+ Agregar alergia</button>
                        </div>
                    </div>
                </form>
            }
        </section>
    </div>

    <div class="col-md-6">
        <section class="info-card h-100">
            <p class="card-eyebrow">ENFERMEDADES DIAGNOSTICADAS (enfermedades)</p>
            @if (Model.Enfermedades.Count == 0)
            {
                <p class="info-card-value">Sin enfermedades registradas</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @foreach (var enfermedad in Model.Enfermedades)
                    {
                        <span class="history-tag">
                            <strong>@enfermedad.Nombre</strong> · Año @enfermedad.AnioDiagnostico
                        </span>
                    }
                </div>
            }
            @if (User.IsInRole("Doctora"))
            {
                <form asp-action="AgregarEnfermedad" method="post" class="mt-3 pt-2 border-top">
                    <input type="hidden" name="PatientId" value="@Model.Patient.Id" />
                    <div class="row g-2">
                        <div class="col-sm-8">
                            <label class="visually-hidden" for="nombreEnfermedad">Nombre de la enfermedad</label>
                            <input id="nombreEnfermedad" name="Nombre" class="form-control form-control-sm" maxlength="150" placeholder="Nombre de la enfermedad (ej. Diabetes tipo 2)" required />
                        </div>
                        <div class="col-sm-4">
                            <label class="visually-hidden" for="anioDiagnostico">Año de diagnóstico</label>
                            <input id="anioDiagnostico" name="AnioDiagnostico" type="number" min="1900" max="@DateTime.Today.Year" value="@DateTime.Today.Year" class="form-control form-control-sm" placeholder="Año" required />
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                            <button class="btn btn-light-blue btn-sm" type="submit">+ Agregar enfermedad</button>
                        </div>
                    </div>
                </form>
            }
        </section>
    </div>
</div>

@if (User.IsInRole("Doctora"))
{
    <div class="section-heading mt-4">
        <div>
            <h2>Estudios y exámenes leídos</h2>
            <p>@Model.Estudios.Count estudio(s) en el expediente</p>
        </div>
    </div>

    <section class="users-card mb-4">
        @if (Model.Estudios.Count == 0)
        {
            <div class="empty-state">
                <h2>Sin estudios registrados</h2>
                <p>Los estudios médicos (de órdenes emitidas o exámenes externos) aparecerán aquí cuando se interpreten en consulta.</p>
            </div>
        }
        else
        {
            <div class="users-list">
                @foreach (var estudio in Model.Estudios)
                {
                    <article class="history-row">
                        <span class="history-date">@estudio.Fecha.ToString("dd")<small>@estudio.Fecha.ToString("MMM").ToUpperInvariant()</small></span>
                        <div class="user-details">
                            <strong>@estudio.NombreMostrar</strong>
                            <span>@estudio.Observaciones</span>
                        </div>
                        <span class="badge rounded-pill @(estudio.IdDetalleOrden.HasValue ? "text-bg-primary" : "text-bg-secondary")">
                            @(estudio.IdDetalleOrden.HasValue ? $"Orden #{estudio.IdDetalleOrden}" : "Examen externo")
                        </span>
                    </article>
                }
            </div>
        }
    </section>

    <div class="section-heading mt-4">
        <div>
            <h2>Historial de consultas</h2>
            <p>@Model.Consultations.Count atención(es) registrada(s)</p>
        </div>
    </div>

    <section class="users-card">
        @if (Model.Consultations.Count == 0)
        {
            <div class="empty-state">
                <h2>Aún no hay consultas</h2>
                <p>Las atenciones aparecerán aquí cuando se registren.</p>
            </div>
        }
        else
        {
            <div class="users-list">
                @foreach (var consultation in Model.Consultations)
                {
                    <article class="history-row">
                        <span class="history-date">@consultation.FechaHoraInicio.ToString("dd")<small>@consultation.FechaHoraInicio.ToString("MMM").ToUpperInvariant()</small></span>
                        <div class="user-details">
                            <strong>@(string.IsNullOrWhiteSpace(consultation.Diagnostico) ? "Consulta sin diagnóstico cerrado" : consultation.Diagnostico)</strong>
                            <span>@(string.IsNullOrWhiteSpace(consultation.Motivo) ? "Sin motivo registrado" : consultation.Motivo) · @consultation.Estado</span>
                        </div>
                        @if (consultation.Estado == EstadoConsulta.Cerrada)
                        {
                            <a class="btn btn-light-blue btn-sm"
                               asp-controller="Consultas" asp-action="Detalle" asp-route-id="@consultation.Id">Ver consulta</a>
                        }
                        else
                        {
                            <a class="btn btn-primary btn-sm"
                               asp-controller="Consultas" asp-action="Atender" asp-route-id="@consultation.Id">Continuar consulta</a>
                        }
                    </article>
                }
            </div>
        }
    </section>
}

@if (User.IsInRole("Secretaria"))
{
    <div class="d-flex justify-content-end mt-3">
        <form asp-controller="SalaEspera" asp-action="RegistrarLlegada" method="post">
            <input type="hidden" name="pacienteId" value="@Model.Patient.Id" />
            <button class="btn btn-primary" type="submit">Registrar llegada de hoy</button>
        </form>
    </div>
}
