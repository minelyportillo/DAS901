@model ClinicaApp.ViewModels.PatientSearchViewModel

@{
    ViewData["Title"] = "Buscar pacientes";
}

<div class="page-heading">
    <div>
        <p class="page-kicker">PACIENTES</p>
        <h1>Expedientes</h1>
        <p class="page-subtitle">Busca por nombre o número de DUI.</p>
    </div>
    @if (User.IsInRole("Secretaria"))
    {
        <a class="btn btn-primary" asp-action="Registrar">+ Agregar paciente</a>
    }
</div>

<form asp-action="Buscar" method="get" class="patient-search-form">
    <label class="visually-hidden" for="termino">Nombre o DUI</label>
    <input id="termino" name="termino" value="@Model.Term" class="form-control"
           placeholder="Buscar por nombre o DUI..." autocomplete="off" />
    <button class="btn btn-primary" type="submit">Buscar</button>
</form>

<div class="section-heading">
    <div>
        <h2>Pacientes</h2>
        <p>@Model.Patients.Count resultado(s)</p>
    </div>
</div>

<section class="users-card">
    @if (Model.Patients.Count == 0)
    {
        <div class="empty-state">
            <h2>No se encontraron pacientes</h2>
            <p>Prueba con otro nombre o DUI.@(User.IsInRole("Secretaria") ? " También puedes registrar un expediente nuevo." : "")</p>
            @if (User.IsInRole("Secretaria"))
            {
                <a class="btn btn-primary" asp-action="Registrar">Registrar paciente</a>
            }
        </div>
    }
    else
    {
        <div class="users-list">
            @foreach (var patient in Model.Patients)
            {
                <article class="user-row patient-row">
                    <span class="user-avatar" aria-hidden="true">@patient.Nombre[..1].ToUpperInvariant()</span>
                    <div class="user-details">
                        <strong>@patient.Nombre</strong>
                        <span>DUI: @(string.IsNullOrWhiteSpace(patient.Dui) ? "No registrado" : patient.Dui) · @patient.Age años · Nac.: @patient.FechaNacimiento.ToString("dd/MM/yyyy")</span>
                    </div>
                    <a class="btn btn-light-blue btn-sm" asp-action="Expediente" asp-route-id="@patient.Id">Ver expediente</a>
                    @if (User.IsInRole("Secretaria"))
                    {
                        <form asp-controller="SalaEspera" asp-action="RegistrarLlegada" method="post">
                            <input type="hidden" name="pacienteId" value="@patient.Id" />
                            <button class="btn btn-primary btn-sm" type="submit">Registrar llegada</button>
                        </form>
                    }
                </article>
            }
        </div>
    }
</section>
