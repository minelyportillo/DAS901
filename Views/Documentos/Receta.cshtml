@model ClinicaApp.ViewModels.PrescriptionViewModel

@{
    var esEdicion = Model.DetalleId.HasValue;
    ViewData["Title"] = esEdicion ? "Editar medicamento de la receta" : "Agregar medicamento";
}

<div class="page-heading">
    <div>
        <p class="page-kicker">DOCUMENTOS · CONSULTA #@Model.ConsultationId</p>
        <h1>@(esEdicion ? "Editar medicamento de la receta" : "Agregar medicamento a la receta")</h1>
        <p class="page-subtitle">Selecciona un medicamento del catálogo y completa las indicaciones (tabla detalle_receta).</p>
    </div>
    <a class="btn btn-light-blue" asp-controller="Consultas" asp-action="Atender" asp-route-id="@Model.ConsultationId">&larr; Volver a consulta</a>
</div>

<form asp-action="Receta" method="post" class="form-card document-form">
    <input asp-for="ConsultationId" type="hidden" />
    <input asp-for="DetalleId" type="hidden" />
    <div class="form-card-header">
        <div>
            <h2>Detalle de receta (detalle_receta)</h2>
            <p>Si el medicamento no aparece en la lista, presiona el botón "Agregar" para registrarlo en el catálogo.</p>
        </div>
        <a class="btn btn-light-blue btn-sm"
           asp-action="NuevoMedicamento"
           asp-route-consultaId="@Model.ConsultationId"
           asp-route-detalleId="@Model.DetalleId">+ Agregar medicamento</a>
    </div>
    <div class="form-card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="IdMedicamento" class="form-label"></label> <span class="text-danger">*</span>
                <div class="d-flex gap-2">
                    <select asp-for="IdMedicamento" class="form-select">
                        <option value="">-- Seleccionar medicamento --</option>
                        @foreach (var med in Model.CatalogoMedicamentos)
                        {
                            <option value="@med.Id">@med.Nombre</option>
                        }
                    </select>
                    <a class="btn btn-outline-primary text-nowrap"
                       asp-action="NuevoMedicamento"
                       asp-route-consultaId="@Model.ConsultationId"
                       asp-route-detalleId="@Model.DetalleId">+ Agregar</a>
                </div>
                <span asp-validation-for="IdMedicamento" class="text-danger"></span>
                <div class="form-text">¿No encuentras el medicamento? Haz clic en <strong>+ Agregar</strong> para abrir el formulario de registro de medicamentos.</div>
            </div>

            <div class="col-md-4">
                <label asp-for="Dosis" class="form-label"></label> <span class="text-danger">*</span>
                <input asp-for="Dosis" class="form-control" placeholder="Ej. 1 tableta / 500 mg" />
                <span asp-validation-for="Dosis" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Frecuencia" class="form-label"></label> <span class="text-danger">*</span>
                <input asp-for="Frecuencia" class="form-control" placeholder="Ej. Cada 8 horas" />
                <span asp-validation-for="Frecuencia" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Duracion" class="form-label"></label> <span class="text-danger">*</span>
                <input asp-for="Duracion" class="form-control" placeholder="Ej. 7 días" />
                <span asp-validation-for="Duracion" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Indicaciones" class="form-label"></label>
                <textarea asp-for="Indicaciones" class="form-control" rows="3" placeholder="Ej. Tomar después de los alimentos con abundante agua"></textarea>
                <span asp-validation-for="Indicaciones" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="form-card-footer">
        <a class="btn btn-outline-secondary" asp-controller="Consultas" asp-action="Atender" asp-route-id="@Model.ConsultationId">Cancelar</a>
        <button class="btn btn-primary" type="submit">@(esEdicion ? "Guardar cambios" : "Agregar a receta")</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
