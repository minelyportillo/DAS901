@model ClinicaApp.Models.Medicamento
@{
    ViewData["Title"] = "Nuevo Medicamento";
}

<div class="container mt-4">
    <h2>Registrar Medicamento</h2>
    <form asp-action="Create" method="post" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre del Medicamento</label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. Amoxicilina 500 mg" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-success">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>