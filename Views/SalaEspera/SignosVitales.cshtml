@model ClinicaApp.ViewModels.TriageViewModel

@{
    ViewData["Title"] = "Triaje";
}

<div class="page-heading">
    <div>
        <p class="page-kicker">TRIAJE · REGISTRO DE LLEGADA</p>
        <h1>Signos vitales iniciales</h1>
        <p class="page-subtitle">@Model.PatientName · Completa el peso, la altura y la temperatura.</p>
    </div>
    <span class="step-pill">Paso 1 de 2</span>
</div>

<form asp-action="SignosVitales" method="post" class="form-card">
    <input asp-for="ConsultationId" type="hidden" />
    <input asp-for="PatientName" type="hidden" />
    <div class="form-card-header">
        <div><h2>Datos de ingreso (signos_vitales)</h2><p>Registra los valores medidos durante la recepción.</p></div>
    </div>
    <div class="form-card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Peso" class="form-label"></label>
                <div class="input-group"><input asp-for="Peso" class="form-control" type="number" step="0.1" /><span class="input-group-text">kg</span></div>
                <span asp-validation-for="Peso" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Altura" class="form-label"></label>
                <div class="input-group"><input asp-for="Altura" class="form-control" type="number" step="0.01" /><span class="input-group-text">m</span></div>
                <span asp-validation-for="Altura" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Temperatura" class="form-label"></label>
                <div class="input-group"><input asp-for="Temperatura" class="form-control" type="number" step="0.1" /><span class="input-group-text">°C</span></div>
                <span asp-validation-for="Temperatura" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Prioridad" class="form-label"></label>
                <select asp-for="Prioridad" asp-items="Html.GetEnumSelectList<PrioridadAtencion>()" class="form-select"></select>
                <span asp-validation-for="Prioridad" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="form-card-footer">
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        <button class="btn btn-primary" type="submit">Guardar triaje</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
