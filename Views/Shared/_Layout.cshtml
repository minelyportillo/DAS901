<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClinicaApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClinicaApp.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell">
            <partial name="_Navbar" />
            <div class="app-content">
                <main class="content-inner" role="main">
                    <partial name="_Alertas" />
                    @RenderBody()
                </main>
                <footer class="app-footer">
                    <span>&copy; @DateTime.Now.Year Sistema de Gestión Clínica</span>
                </footer>
            </div>
        </div>
    }
    else
    {
        <main class="unauthenticated-shell" role="main">
            <partial name="_Alertas" />
            @RenderBody()
        </main>
    }
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
